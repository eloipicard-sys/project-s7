# Copier ce fichier en `.env` avant de lancer docker compose :
#   cp .env.example .env
#
# Configuration automate Siemens S7-1500 (laboratoire Politechnika Śląska)
PLC_IP=192.168.1.10
PLC_RACK=0
PLC_SLOT=1

# Numéro du DB utilisé par l'interface de test (V1 BOOL @ DBX0.0 / V2 INT @ DBW2)
PLC_TEST_DB=1

# Flask : 1 = rechargement à chaud, 0 en production
FLASK_DEBUG=1
